<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar" />

    <!-- タイトル入力 -->
    <EditText
        android:id="@+id/etTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_title"
        android:padding="12dp"
        android:textSize="18sp"
        android:textStyle="bold"
        android:background="@android:color/white"
        android:imeOptions="actionNext"
        android:inputType="text" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0" />

    <!-- 書式ツールバー（横スクロール可） -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:background="#F5F5F5">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <Button
                android:id="@+id/btnBold"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:text="B"
                android:textStyle="bold"
                android:textSize="16sp"
                android:padding="4dp" />

            <Button
                android:id="@+id/btnItalic"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:text="I"
                android:textStyle="italic"
                android:textSize="16sp"
                android:padding="4dp" />

            <Button
                android:id="@+id/btnUnderline"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:text="U"
                android:textSize="16sp"
                android:padding="4dp" />

            <View android:layout_width="1dp" android:layout_height="28dp" android:background="#BDBDBD" android:layout_marginHorizontal="4dp" />

            <Button
                android:id="@+id/btnH1"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="48dp"
                android:layout_height="40dp"
                android:text="H2"
                android:textSize="14sp"
                android:padding="4dp" />

            <Button
                android:id="@+id/btnUl"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:text="• ─"
                android:textSize="12sp"
                android:padding="4dp" />

            <Button
                android:id="@+id/btnOl"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:text="1."
                android:textSize="14sp"
                android:padding="4dp" />

            <Button
                android:id="@+id/btnCode"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="52dp"
                android:layout_height="40dp"
                android:text="&lt;/&gt;"
                android:textSize="12sp"
                android:padding="4dp" />

            <View android:layout_width="1dp" android:layout_height="28dp" android:background="#BDBDBD" android:layout_marginHorizontal="4dp" />

            <Button
                android:id="@+id/btnMath"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="52dp"
                android:layout_height="40dp"
                android:text="∑fx"
                android:textSize="14sp"
                android:padding="4dp" />

            <Button
                android:id="@+id/btnImage"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="52dp"
                android:layout_height="40dp"
                android:text="🖼"
                android:textSize="16sp"
                android:padding="4dp" />

            <View android:layout_width="1dp" android:layout_height="28dp" android:background="#BDBDBD" android:layout_marginHorizontal="4dp" />

            <Button
                android:id="@+id/btnClear"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="52dp"
                android:layout_height="40dp"
                android:text="T✗"
                android:textSize="13sp"
                android:padding="4dp" />

            <View android:layout_width="1dp" android:layout_height="28dp" android:background="#BDBDBD" android:layout_marginHorizontal="4dp" />

            <Button
                android:id="@+id/btnPageUp"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="48dp"
                android:layout_height="40dp"
                android:text="⇑"
                android:textSize="18sp"
                android:padding="4dp" />

            <Button
                android:id="@+id/btnPageDown"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="48dp"
                android:layout_height="40dp"
                android:text="⇓"
                android:textSize="18sp"
                android:padding="4dp" />

        </LinearLayout>
    </HorizontalScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0" />

    <!-- WebViewエディタ -->
    <WebView
        android:id="@+id/webEditor"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@android:color/white" />

</LinearLayout>
